  m_Name: MomIntro
  m_EditorClassIdentifier: Assembly-CSharp::NPCDIalogue
  npcName: Mom
  npcPortrait: {fileID: -6674868978544099146, guid: 4cb3c8e0fd9964e4796a83414ae5d252,
    type: 3}
  lines:
  - Red! There you are! Where have you been??  I need you for something important.
  - You must take this food and medicine to your Grandma, she's very sick.
  - You should remember how to get there. Go through the forest and follow the path.
    Don't go wandering off. If you hurry, you'll get there before night falls.
  - You're being dramatic! If you do exactly as I say, you won't die! When have I
    ever been wrong??
  - ...
  - Don't answer that.
  - I'm glad you understand. Go on.
  - You'll do as I say! Now go on before your Grandma starves to death!!!
  endDialogueLines: 0000000000000101
  typingSpeed: 1
  voiceSound: {fileID: 0}
  voicePitch: 1
